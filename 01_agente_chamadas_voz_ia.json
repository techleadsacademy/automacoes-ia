{
  "name": "1 - Agente de chamadas de voz com IA",
  "nodes": [
    {
      "id": "fac9ea1b-86e2-452e-9325-2090d16a0355",
      "name": "Webhook (chamada recebida)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "parameters": {
        "path": "chamada-recebida",
        "httpMethod": "POST",
        "responseMode": "responseNode"
      },
      "notes": "Recebe o evento de chamada do seu provedor de telefonia (Twilio, Vonage etc.)"
    },
    {
      "id": "0a45f71e-0129-4494-bf6a-34aa7a678741",
      "name": "Agente de Chamadas (OpenAI Realtime)",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.3,
      "position": [
        500,
        300
      ],
      "parameters": {
        "resource": "assistant",
        "operation": "message",
        "prompt": "Você é um atendente de voz da recepção. Responda dúvidas sobre disponibilidade, agende horários e encaminhe para um humano quando necessário."
      },
      "notes": "Configure a credencial da OpenAI. Este nó representa a chamada ao modelo em tempo real."
    },
    {
      "id": "8862a344-d34f-4f5c-9e5f-f44e7ac3deb8",
      "name": "Roteador de Intenção",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [
        760,
        300
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "disponibilidade",
              "conditions": {
                "string": [
                  {
                    "value1": "={{$json.intent}}",
                    "value2": "disponibilidade"
                  }
                ]
              }
            },
            {
              "outputKey": "duvida",
              "conditions": {
                "string": [
                  {
                    "value1": "={{$json.intent}}",
                    "value2": "duvida"
                  }
                ]
              }
            },
            {
              "outputKey": "humano",
              "conditions": {
                "string": [
                  {
                    "value1": "={{$json.intent}}",
                    "value2": "humano"
                  }
                ]
              }
            }
          ]
        }
      },
      "notes": "Direciona a conversa com base na intenção identificada pelo agente."
    },
    {
      "id": "72417876-6d30-40f0-a3db-33429efed144",
      "name": "Verificar Disponibilidade",
